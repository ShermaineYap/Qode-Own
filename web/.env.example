# Qwen via Alibaba Cloud Model Studio (Singapore / international endpoint)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_CLASSIFIER_MODEL=qwen-flash
QWEN_VERIFIER_MODEL=qwen-plus

# Shared state between the senior's and guardian's phones (Upstash Redis via Vercel Storage).
# Without these, state is kept in memory, which is unreliable on Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
